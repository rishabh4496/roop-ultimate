# IDE
.vs
.idea
.vscode
.claude

# Python
__pycache__
*.pth
venv
.ruff_cache

# Pinokio launcher env/cache
/env
/start.bat
/run.bat
/start.sh
cache
logs
models

# App runtime directories (also covered by app/.gitignore)
app/env
app/models
app/temp
app/output
app/config.yaml
app/saved_configs
app/facesets

# app/output and app/temp are already ignored above as directories

# Local snapshot of the v1 React UI (canonical backup is the react-ui-v1 git tag)
react-ui-v1-backup/

# React UI 2.0 generated dependencies/build output
react-ui-v2/node_modules/
react-ui-v2/dist/

# Learned runtime-estimate store (per-machine, grows over time)
app/runtime_calibration.json
app/run_history.json
app/profiles.json
# Persisted batch queue (per-machine; jobs reference locally loaded targets)
app/queue.json
app/projects/
app/facesets/
# Root-level copy too. This holds .fsz face libraries and preview PNGs for real,
# named people -- biometric data. `app/facesets/` was ignored and this one was
# not, so a single `git add -A` at the repo root would have published it.
/facesets/
# Root-level benchmark/render outputs (generated, machine-local)
/output/

# Compatibility-gated updater transaction metadata and temporary worktrees
/.update-snapshots/
/.update-staging/
/.update-transaction.json
# KEEP sidecar local state (venv, cloned repo, weights)
app/sidecar_keep/.venv/
app/sidecar_keep/KEEP/
app/sidecar_keep/weights/

# Gemini CLI ignore file: tools rewrite it with a machine-specific
# absolute workspace path (G:\pinokio vs C:\pinokio), so tracking it
# makes every cross-machine pull abort. Kept local per machine.
.geminiignore
