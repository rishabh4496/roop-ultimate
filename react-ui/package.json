{
  "name": "react-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "lint:unreachable": "node scripts/unreachable-modules.mjs",
    "lint:api-timeouts": "node scripts/api-callsites.mjs",
    "verify:offline": "node scripts/verify-offline-bundle.mjs",
    "test:offline-bundle": "node scripts/test-verify-offline-bundle.mjs",
    "test:render": "node .render-check/run.mjs",
    "test:mapping": "node .render-check/face-mapping-check.mjs",
    "test:stage14": "node .render-check/stage14-async-check.mjs",
    "test:batch": "node .render-check/batch-matrix-check.mjs",
    "test:render:mutations": "node .render-check/mutation-check.mjs",
    "preview": "vite preview",
    "test:player": "node .render-check/player-check.mjs",
    "test:error-boundary": "node .render-check/error-boundary-check.mjs",
    "test:api-client": "node .render-check/run-module.mjs render-api-client.mjs",
    "test:recognition": "node .render-check/recognition-sync-check.mjs",
    "test:retry-policy": "node .render-check/retry-policy-check.mjs",
    "test:brush": "node .render-check/brush-mapping-check.mjs",
    "test:pipeline-report": "node .render-check/run-module.mjs render-pipeline-report.mjs",
    "test:pipeline-pill": "node .render-check/run-module.mjs render-pipeline-pill.mjs",
    "test:retired-controls": "node .render-check/run-module.mjs render-retired-controls.mjs",
    "test:head-pose-hud": "node .render-check/run-module.mjs render-head-pose-hud.mjs",
    "test:provider-matrix": "node .render-check/run-module.mjs render-provider-matrix.mjs",
    "test:pipeline-controls": "node .render-check/run-module.mjs render-pipeline-controls.mjs",
    "test:video-io-hud": "node .render-check/run-module.mjs video-io-hud-check.mjs",
    "test:workstation": "node .render-check/run-module.mjs render-workstation-logic.mjs",
    "test:timeline": "node .render-check/run-module.mjs render-timeline-logic.mjs",
    "test:stage5": "node .render-check/run-module.mjs render-stage5-logic.mjs",
    "test:stage8": "node .render-check/run-module.mjs render-stage8-logic.mjs",
    "test:mouth-custody": "node .render-check/run-module.mjs render-mouth-custody.mjs",
    "test:stage18": "node .render-check/run-module.mjs render-stage18-lut.mjs",
    "test:stage19": "node .render-check/run-module.mjs render-stage19-monitor.mjs",
    "test:identity-keyframes": "node .render-check/run-module.mjs render-identity-keyframes.mjs",
    "test:stage21": "node .render-check/run-module.mjs render-stage21-stereo-vr.mjs",
    "test:console-mirror": "node .render-check/run-module.mjs render-console-mirror.mjs",
    "test:stage11": "node .render-check/run-module.mjs render-stage11-logic.mjs",
    "test:trt-queues": "node .render-check/run-module.mjs render-stage14.mjs",
    "test:render-checks": "npm run test:render &&npm run test:mapping && npm run test:stage14 && npm run test:batch && npm run test:render:mutations && npm run test:player && npm run test:error-boundary && npm run test:api-client && npm run test:recognition && npm run test:retry-policy && npm run test:brush && npm run test:pipeline-report && npm run test:pipeline-pill && npm run test:retired-controls && npm run test:head-pose-hud && npm run test:provider-matrix && npm run test:pipeline-controls && npm run test:video-io-hud && npm run test:workstation && npm run test:timeline && npm run test:stage5 && npm run test:stage8 && npm run test:console-mirror && npm run test:stage11 && npm run test:trt-queues && npm run test:mouth-custody && npm run test:stage18 && npm run test:stage19 && npm run test:identity-keyframes && npm run test:stage21",
    "test:e2e": "playwright test -c e2e/playwright.config.js",
    "test:e2e:baseline": "node e2e/baseline.js",
    "test:e2e:themes": "node e2e/run-themes.js",
    "test:e2e:themes:baseline": "node e2e/run-themes.js --update",
    "check": "npm run lint && npm run lint:unreachable && npm run lint:api-timeouts && npm run build && npm run verify:offline && npm run test:offline-bundle && npm run test:e2e && npm run test:render-checks"
  },
  "dependencies": {
    "@tanstack/react-virtual": "3.14.18",
    "@use-gesture/react": "^10.3.1",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.21.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.3.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.5.2",
    "oxlint": "^1.69.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.1",
    "vite": "^8.1.0"
  }
}
