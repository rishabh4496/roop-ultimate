{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "oxc",
    "jsx-a11y"
  ],
  "env": {
    "browser": true,
    "es2024": true
  },
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": [
      "warn",
      {
        "allowConstantExport": true
      }
    ],
    "no-undef": "error",
    "react/exhaustive-deps": "error",
    "jsx-a11y/alt-text": "error",
    "jsx-a11y/anchor-has-content": "error",
    "jsx-a11y/anchor-is-valid": "error",
    "jsx-a11y/aria-props": "error",
    "jsx-a11y/aria-role": "error",
    "jsx-a11y/aria-unsupported-elements": "error",
    "jsx-a11y/autocomplete-valid": "error",
    "jsx-a11y/click-events-have-key-events": "error",
    "jsx-a11y/heading-has-content": "error",
    "jsx-a11y/html-has-lang": "error",
    "jsx-a11y/iframe-has-title": "error",
    "jsx-a11y/img-redundant-alt": "error",
    "jsx-a11y/label-has-associated-control": "error",
    "jsx-a11y/lang": "error",
    "jsx-a11y/media-has-caption": "error",
    "jsx-a11y/mouse-events-have-key-events": "error",
    "jsx-a11y/no-aria-hidden-on-focusable": "error",
    "jsx-a11y/no-autofocus": "error",
    "jsx-a11y/no-distracting-elements": "error",
    "jsx-a11y/no-noninteractive-element-interactions": "error",
    "jsx-a11y/no-noninteractive-tabindex": "error",
    "jsx-a11y/no-redundant-roles": "error",
    "jsx-a11y/no-static-element-interactions": "error",
    "jsx-a11y/prefer-tag-over-role": "off",
    "jsx-a11y/role-has-required-aria-props": "error",
    "jsx-a11y/role-supports-aria-props": "error",
    "jsx-a11y/scope": "error",
    "jsx-a11y/tabindex-no-positive": "error"
  },
  "overrides": [
    {
      "files": [
        "vite.config.js",
        "*.config.js"
      ],
      "env": {
        "node": true
      }
    },
    {
      "files": [
        "scripts/**"
      ],
      "env": {
        "node": true
      }
    },
    {
      "files": [
        "mock-server/**",
        "e2e/**"
      ],
      "env": {
        "node": true
      }
    },
    {
      "files": [
        "src/motion.jsx",
        "src/icons.jsx",
        "src/components/confirm.jsx",
        "src/components/QualityProfilesModal.jsx"
      ],
      "rules": {
        "react/only-export-components": "off"
      }
    },
    {
      "files": [
        "src/App.jsx",
        "src/components/BenchmarkPanel.jsx",
        "src/components/FaceSwap.jsx",
        "src/components/Gallery.jsx",
        "src/components/PersonGroups.jsx",
        "src/components/faceswap/FacesetLibrary.jsx",
        "src/components/faceswap/InteractivePreview.jsx",
        "src/components/faceswap/MediaTabSessionBar.jsx",
        "src/components/faceswap/PresetStudioModal.jsx"
      ],
      "rules": {
        "jsx-a11y/click-events-have-key-events": "off"
      }
    },
    {
      "files": [
        "src/components/BenchmarkPanel.jsx"
      ],
      "rules": {
        "jsx-a11y/label-has-associated-control": "off"
      }
    },
    {
      "files": [
        "src/components/OutputCompare.jsx",
        "src/components/OutputVideoPlayer.jsx",
        "src/components/player/VideoCompareStage.jsx"
      ],
      "rules": {
        "jsx-a11y/media-has-caption": "off"
      }
    },
    {
      "files": [
        "src/components/Gallery.jsx",
        "src/components/OutputCompare.jsx",
        "src/components/faceswap/CompareGrid.jsx",
        "src/components/faceswap/FileDrop.jsx",
        "src/components/faceswap/QueuePanel.jsx"
      ],
      "rules": {
        "jsx-a11y/no-noninteractive-element-interactions": "off"
      }
    },
    {
      "files": [
        "src/components/PersonGroups.jsx",
        "src/components/faceswap/CompareGrid.jsx"
      ],
      "rules": {
        "jsx-a11y/no-noninteractive-tabindex": "off"
      }
    },
    {
      "files": [
        "src/App.jsx",
        "src/components/BenchmarkPanel.jsx",
        "src/components/CommandPalette.jsx",
        "src/components/FaceSwap.jsx",
        "src/components/PersonGroups.jsx",
        "src/components/faceswap/FacesetLibrary.jsx",
        "src/components/faceswap/InteractivePreview.jsx",
        "src/components/faceswap/MediaTabSessionBar.jsx",
        "src/components/faceswap/PresetStudioModal.jsx"
      ],
      "rules": {
        "jsx-a11y/no-static-element-interactions": "off"
      }
    }
  ]
}
