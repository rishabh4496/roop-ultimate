{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "oxc"],
  "env": {
    "browser": true,
    "es2024": true
  },
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }],
    "no-undef": "error"
  },
  "overrides": [
    {
      "files": ["vite.config.js", "*.config.js"],
      "env": { "node": true }
    },
    {
      "files": ["scripts/**"],
      "env": { "node": true }
    },
    {
      "files": ["mock-server/**"],
      "env": { "node": true }
    },
    {
      "files": ["src/motion.jsx", "src/icons.jsx", "src/components/confirm.jsx", "src/components/QualityProfilesModal.jsx"],
      "rules": {
        "react/only-export-components": "off"
      }
    }
  ]
}
