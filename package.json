{
  "name": "roop-ultimate",
  "private": true,
  "workspaces": [
    "react-ui"
  ],
  "scripts": {
    "dev": "tsx server.ts",
    "build": "npm run build --workspace=react-ui && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "lint": "npm run lint --workspace=react-ui"
  },
  "dependencies": {
    "express": "^4.21.2",
    "multer": "^2.4.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.10.1",
    "@types/ws": "^8.5.13",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.2",
    "vite": "^8.1.0"
  }
}
